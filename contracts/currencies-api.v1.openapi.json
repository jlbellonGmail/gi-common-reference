  "components": {
    "schemas": {
      "AssociationListEnvelope": {
        "properties": {
          "snapshot_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Version"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/CountryCurrency"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "snapshot_version",
          "data"
        ],
        "title": "AssociationListEnvelope"
      },
      "CountryCurrency": {
        "properties": {
          "country_currency_id": {
            "type": "string",
            "title": "Country Currency Id",
            "description": "Identidad de la asociación (UUID)."
          },
          "country_id": {
            "type": "string",
            "title": "Country Id",
            "description": "UUID de un Country publicado por 003-countries."
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "title": "Status",
            "description": "Ciclo de vida del registro."
          },
          "valid_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid From",
            "description": "Primer día en que corresponde (incluido); `null` si no está acotado."
          },
          "valid_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To",
            "description": "Primer día en que ya no corresponde (excluido); `null` sin fin declarado."
          }
        },
        "type": "object",
        "required": [
          "country_currency_id",
          "country_id",
          "currency",
          "status",
          "valid_from",
          "valid_to"
        ],
        "title": "CountryCurrency",
        "description": "Asociación Country–Currency. `status` es el ciclo de vida del registro; la vigencia es el\nperíodo real `[valid_from, valid_to)` y no la sustituye."
      },
      "Currency": {
        "properties": {
          "currency_id": {
            "type": "string",
            "title": "Currency Id",
            "description": "Identidad estable de la moneda (UUID de Reference)."
          },
          "alphabetic_code": {
            "type": "string",
            "title": "Alphabetic Code",
            "description": "ISO 4217 alfabético (`USD`)."
          },
          "numeric_code": {
            "type": "string",
            "title": "Numeric Code",
            "description": "ISO 4217 numérico, con ceros (`032`). Solo atributo."
          },
          "minor_units": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minor Units",
            "description": "Dígitos decimales estándar; `null` es «no aplicable» (distinto de 0)."
          },
          "fund_code": {
            "type": "boolean",
            "title": "Fund Code",
            "description": "ISO la declara código de fondos."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "title": "Status",
            "description": "`active`: apta para nuevas referencias; `inactive`: sigue resoluble."
          },
          "replacement_currency_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Replacement Currency Ids",
            "description": "Monedas sucesoras (0..N), en orden ascendente de `currency_id`; vacío si no hay sucesión declarada o si la moneda es `active`."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Nombre en el `locale_id` pedido, o `null`."
          }
        },
        "type": "object",
        "required": [
          "currency_id",
          "alphabetic_code",
          "numeric_code",
          "minor_units",
          "fund_code",
          "status",
          "replacement_currency_ids",
