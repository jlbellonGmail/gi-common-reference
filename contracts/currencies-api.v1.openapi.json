{
  "openapi": "3.1.0",
  "info": {
    "title": "gi-common-reference: currencies",
    "description": "Catálogo global de monedas ISO 4217, versionado y de solo lectura: identidad `currency_id`, código alfabético de resolución, nombres por `locale_id` y asociaciones Country–Currency con vigencia temporal. Sin cotizaciones, tipos de cambio, precios ni saldos.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/currencies/version": {
      "get": {
        "tags": [
          "currencies"
        ],
        "summary": "Versión aplicada del catálogo Currency",
        "operationId": "getCurrencyCatalogVersion",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Falla técnica (distinta de 404 y 422).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/currencies/by-code/{code}": {
      "get": {
        "tags": [
          "currencies"
        ],
        "summary": "Obtener una moneda por su código alfabético ISO 4217",
        "description": "Sin distinguir mayúsculas (`usd`). Un código mal formado (` USD`, `US`, vacío) es 422;\nuno bien formado que no existe, 404. Resuelve también las monedas `inactive`.",
        "operationId": "getCurrencyByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "locale_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Devuelve `name` en este locale (UUID del catálogo de Locale). Sin traducción es `null`: no hay fallback a otro locale.",
              "title": "Locale Id"
            },
            "description": "Devuelve `name` en este locale (UUID del catálogo de Locale). Sin traducción es `null`: no hay fallback a otro locale."
