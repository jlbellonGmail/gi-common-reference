            "description": "Incluye también los registros `inactive` (por defecto no)."
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Igualdad exacta.",
              "title": "Code"
            },
            "description": "Igualdad exacta."
          },
          {
            "name": "locale_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Devuelve `name` (y `plural`) en este locale (UUID del catálogo de Locale). Sin traducción es `null`: no hay fallback a otro locale.",
              "title": "Locale Id"
            },
            "description": "Devuelve `name` (y `plural`) en este locale (UUID del catálogo de Locale). Sin traducción es `null`: no hay fallback a otro locale."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuantityKindListEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Parámetro inválido (distinto de 404).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Falla técnica (distinta de 404 y 422).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
