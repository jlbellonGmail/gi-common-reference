{
  "openapi": "3.1.0",
  "info": {
    "title": "gi-common-reference: units",
    "description": "Catálogo global de magnitudes y unidades de medida, versionado y de solo lectura: identidades estables, códigos UCUM/UNECE, nombres por `locale_id` y conversión exacta entre unidades de una magnitud. Sin cantidades, precios, productos ni unidades específicas de un tenant.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/quantity-kinds/{quantity_kind_id}": {
      "get": {
        "tags": [
          "quantity-kinds"
        ],
        "summary": "Obtener una magnitud por su quantity_kind_id, cualquiera sea su status",
        "description": "Un id mal formado es 422; uno bien formado que no existe, 404.",
        "operationId": "getQuantityKind",
        "parameters": [
          {
            "name": "quantity_kind_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Quantity Kind Id"
            }
          },
          {
            "name": "locale_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Devuelve `name` (y `plural`) en este locale (UUID del catálogo de Locale). Sin traducción es `null`: no hay fallback a otro locale.",
              "title": "Locale Id"
            },
            "description": "Devuelve `name` (y `plural`) en este locale (UUID del catálogo de Locale). Sin traducción es `null`: no hay fallback a otro locale."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuantityKindEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Parámetro inválido (distinto de 404).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Falla técnica (distinta de 404 y 422).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
