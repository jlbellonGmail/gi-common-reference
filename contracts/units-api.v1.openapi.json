    "/v1/units": {
      "get": {
        "tags": [
          "units"
        ],
        "summary": "Listar las unidades, ordenadas por símbolo (orden binario) e id",
        "operationId": "listUnits",
        "parameters": [
          {
            "name": "quantity_kind_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Unidades asociadas (activas) a esa magnitud; 404 si no existe.",
              "title": "Quantity Kind Id"
            },
            "description": "Unidades asociadas (activas) a esa magnitud; 404 si no existe."
          },
          {
            "name": "ucum_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Igualdad exacta.",
              "title": "Ucum Code"
            },
            "description": "Igualdad exacta."
          },
          {
            "name": "unece_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Igualdad exacta.",
              "title": "Unece Code"
            },
            "description": "Igualdad exacta."
          },
          {
            "name": "include_inactive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Incluye también los registros `inactive` (por defecto no).",
              "default": false,
