{
  "openapi": "3.1.0",
  "info": {
    "title": "gi-common-reference: regions",
    "description": "Catálogo global de regiones y subregiones UN M49, versionado y de solo lectura, con nombres por locale_id.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/regions/by-code/{code}": {
      "get": {
        "tags": [
          "regions"
        ],
        "summary": "Obtener una Region por su código UN M49 vigente",
        "description": "La `active` que tiene el código; si ninguna, la `inactive` que lo obtuvo en el snapshot\nmás reciente. Un código que no tiene 3 dígitos es 422; un código histórico, 404.",
        "operationId": "getRegionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "locale_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Devuelve el nombre en este locale (UUID del catálogo de Locale). Sin traducción, `name` es `null`: no hay fallback a otro locale.",
              "title": "Locale Id"
            },
            "description": "Devuelve el nombre en este locale (UUID del catálogo de Locale). Sin traducción, `name` es `null`: no hay fallback a otro locale."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Parámetro inválido (distinto de 404).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
