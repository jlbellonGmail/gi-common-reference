      "get": {
        "tags": [
          "regions"
        ],
        "summary": "Listar las regiones publicadas, ordenadas por código",
        "operationId": "listRegions",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive"
              ]
            },
            "description": "Restringe el resultado a un `status`."
          },
          {
            "name": "locale_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Devuelve el nombre en este locale (UUID del catálogo de Locale). Sin traducción, `name` es `null`: no hay fallback a otro locale.",
              "title": "Locale Id"
            },
            "description": "Devuelve el nombre en este locale (UUID del catálogo de Locale). Sin traducción, `name` es `null`: no hay fallback a otro locale."
          }
        ],
        "responses": {
          "200": {
