  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorEnvelope": {
        "properties": {
          "snapshot_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Version",
            "description": "Snapshot vigente, o `null` si no hay."
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "snapshot_version",
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "Region": {
        "properties": {
          "region_id": {
            "type": "string",
            "title": "Region Id",
            "description": "Identidad estable de la Region (UUID asignado por PREP)."
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code",
            "description": "Código UN M49 vigente de 3 dígitos, o `null`."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "title": "Status",
            "description": "`active`: apta para nuevas referencias; `inactive`: sigue resoluble."
          },
          "replacement_region_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replacement Region Id",
            "description": "Region sucesora según la fuente de autoridad; solo si es `inactive`."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Nombre en el `locale_id` pedido, o `null`."
          }
        },
        "type": "object",
        "required": [
          "region_id",
          "code",
          "status",
          "replacement_region_id",
          "name"
        ],
        "title": "Region",
        "description": "Región UN M49 (nivel superior, p. ej. 019 Americas). Sin textos propios (RF-8)."
      },
      "RegionEnvelope": {
        "properties": {
          "snapshot_version": {
            "type": "integer",
            "title": "Snapshot Version",
            "description": "Snapshot vigente del catálogo Region/Subregion."
          },
          "data": {
            "$ref": "#/components/schemas/Region"
          }
        },
        "type": "object",
        "required": [
          "snapshot_version",
          "data"
        ],
        "title": "RegionEnvelope"
      },
      "RegionListEnvelope": {
        "properties": {
          "snapshot_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Version",
            "description": "Snapshot vigente; `null` si todavía no se incorporó ninguno."
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/Region"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "snapshot_version",
          "data"
        ],
        "title": "RegionListEnvelope"
      },
      "Subregion": {
        "properties": {
          "subregion_id": {
            "type": "string",
            "title": "Subregion Id",
            "description": "Identidad estable de la Subregion (UUID de PREP)."
          },
          "region_id": {
            "type": "string",
            "title": "Region Id",
            "description": "Region que la contiene."
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code",
            "description": "Código UN M49 vigente de 3 dígitos, o `null`."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "title": "Status",
            "description": "`active`: apta para nuevas referencias; `inactive`: sigue resoluble."
          },
          "replacement_subregion_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replacement Subregion Id",
            "description": "Subregion sucesora según la fuente de autoridad; solo si es `inactive`."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Nombre en el `locale_id` pedido, o `null`."
          }
        },
        "type": "object",
        "required": [
          "subregion_id",
          "region_id",
          "code",
          "status",
          "replacement_subregion_id",
          "name"
        ],
        "title": "Subregion",
        "description": "Subregión UN M49, contenida en exactamente una Region (p. ej. 419 en 019)."
      },
      "SubregionEnvelope": {
        "properties": {
          "snapshot_version": {
            "type": "integer",
            "title": "Snapshot Version",
            "description": "Snapshot vigente del catálogo Region/Subregion."
          },
          "data": {
            "$ref": "#/components/schemas/Subregion"
          }
        },
        "type": "object",
        "required": [
          "snapshot_version",
          "data"
        ],
        "title": "SubregionEnvelope"
      },
      "SubregionListEnvelope": {
        "properties": {
          "snapshot_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Version",
            "description": "Snapshot vigente; `null` si todavía no se incorporó ninguno."
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/Subregion"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "snapshot_version",
          "data"
        ],
        "title": "SubregionListEnvelope"
      }
    }
  }
}
