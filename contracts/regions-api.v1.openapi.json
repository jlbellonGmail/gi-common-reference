        "summary": "Listar las subregiones publicadas, ordenadas por código",
        "operationId": "listSubregions",
        "parameters": [
          {
            "name": "region_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Restringe el resultado a una Region.",
              "title": "Region Id"
            },
