    "/v1/countries/by-numeric/{code}": {
      "get": {
        "tags": [
          "countries"
        ],
        "summary": "Obtener un país por su código ISO numérico vigente",
        "description": "Texto exacto de 3 dígitos (`004`); `4` es 422.",
        "operationId": "getCountryByNumeric",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "locale_id",
