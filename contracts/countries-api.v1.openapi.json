    "/v1/countries/{country_id}/flag": {
      "get": {
        "tags": [
          "countries"
        ],
        "summary": "Obtener la bandera SVG de un país",
        "operationId": "getCountryFlag",
        "parameters": [
          {
            "name": "country_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Country Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "El asset SVG de la bandera; `ETag` es su suma de verificación.",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "`\"sha256:…\"`"
              }
            }
          },
          "404": {
            "description": "`country_not_found`, o `flag_not_declared` si el país no tiene bandera.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "`flag_integrity_error`: el asset no coincide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/countries/{country_id}": {
      "get": {
        "tags": [
          "countries"
        ],
        "summary": "Obtener un país por su country_id, cualquiera sea su status",
        "description": "Un `country_id` mal formado es \"no encontrado\" (404), no un error de validación.",
        "operationId": "getCountryById",
        "parameters": [
          {
            "name": "country_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Country Id"
            }
          },
          {
            "name": "locale_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
