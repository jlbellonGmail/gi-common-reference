{
  "openapi": "3.1.0",
  "info": {
    "title": "gi-common-reference: countries",
    "description": "Catálogo global de países ISO 3166-1, versionado y de solo lectura: identidad `country_id`, códigos de resolución, clasificación por `region_id`/`subregion_id`, nombres por `locale_id` y bandera SVG.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/countries/by-alpha2/{code}": {
      "get": {
        "tags": [
          "countries"
        ],
        "summary": "Obtener un país por su código ISO alpha-2 vigente",
        "description": "Sin distinguir mayúsculas. El `active` que lo posee; si ninguno, el `inactive` que lo\nobtuvo más recientemente. Un código mal formado es 422; uno histórico, 404.",
        "operationId": "getCountryByAlpha2",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "locale_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Devuelve `name` y `official_name` en este locale (UUID del catálogo de Locale). Sin traducción son `null`: no hay fallback a otro locale.",
              "title": "Locale Id"
            },
            "description": "Devuelve `name` y `official_name` en este locale (UUID del catálogo de Locale). Sin traducción son `null`: no hay fallback a otro locale."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Parámetro inválido (distinto de 404).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
